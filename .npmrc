# @cloudflare/next-on-pages 1.13.16 declareert een peer op next >= 14.3, maar
# werkt prima met de 14.2.35 die dit project draait — dat is precies de versie
# en combinatie die Cloudflare zelf gebruikt (`npx @cloudflare/next-on-pages@1`).
# Zonder deze vlag loopt de `npm install` die de build intern uitvoert vast op
# die peer. Dit moet hier staan en niet alleen lokaal, want de buildserver
# leest hem ook.
legacy-peer-deps=true
